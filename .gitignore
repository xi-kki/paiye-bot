# ============================================================
# @Paiye_Bot — .gitignore
# ============================================================

# Environment variables (API keys, secrets)
.env

# Node dependencies
node_modules/

# Log files
*.log
bot-output.log
bot-run.log
bot-err.log

# OS files
.DS_Store
Thumbs.db

# User data (resumes, preferences — contains personal info)
userData.json
uploads/

# Feedback & debug
feedback.log

# Windows null-device redirect artifact
nul

# Runtime state lives in the PRIVATE xi-kki/paiye-bot-state repo
# (cloned into .state/ and symlinked into the workspace by run-bot.sh).
# NEVER commit these to this public repo.
.state/
subscribers.json
applications.json
compliance-violations.json
admin-audit.json
blocked-users.json
