# ============================================================
# @Paiye_Bot — Environment Variables (template)
# ============================================================
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your values
# 3. NEVER commit .env to git (it's in .gitignore)


# ── Required ──────────────────────────────────────────────

# Telegram Bot Token — get from @BotFather on Telegram
# TELEGRAM_TOKEN=your_bot_token_here


# ── AI Chat (pick ONE provider) ───────────────────────────

# Option 1: Groq (recommended — fastest, generous free tier)
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Anthropic Claude
# Get a key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 3: OpenAI GPT
# Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o


# ── Optional ──────────────────────────────────────────────

# Findwork API (tech jobs)
# Get a key: https://findwork.dev/developers/
# FINDWORK_API_KEY=your_key_here

# Admin IDs (comma-separated Telegram user IDs)
# Get your ID: message @userinfobot on Telegram
# ADMIN_IDS=123456789,987654321

# Custom AI system prompt
# AI_SYSTEM_PROMPT=You are a helpful job search assistant...

# Rate limiter mode: strict | lenient | log_only (default: lenient)
# RATE_LIMIT_MODE=lenient
